{
  "name": "cms-enterprise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/002_crm_schema.sql'",
    "db:migrate:contact-enhancements": "dotenv -e .env -- sh -c  'psql \"$DATABASE_URL\" -f database/migrations/003_contact_enhancements.sql'",
    "db:seed": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/seeds/003_add_manage_roles_permission.sql'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "next": "16.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "eslint-config-next": "16.1.5",
    "next-auth": "^4.24.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
