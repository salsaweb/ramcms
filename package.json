{
  "name": "cms-enterprise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate-api-key": "node ./scripts/generate-api-key.ts",
    "db:migrate:initial-schema": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/001_initial_schema.sql'",
    "db:migrate:crm-schema": "dotenv -e .env -- sh -c  'psql \"$DATABASE_URL\" -f database/migrations/002_crm_schema.sql'",
    "db:migrate:contact-enhancements": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/003_contact_enhancements.sql'",
    "db:migrate:advanced-features": "dotenv -e .env -- sh -c  'psql \"$DATABASE_URL\" -f database/migrations/004_advanced_features.sql'",
    "db:add-settings-permission": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/005_add_settings_permission.sql'",
    "db:add-custom-rbac": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/006_custom_rbac.sql'",
    "db:grant-admin-rbac": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/007_grant_admin_rbac_permissions.sql'",
    "db:fix-role-names": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/008_fix_role_name_constraint.sql'",
    "db:api-authentication": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/009_api_authentication.sql'",
    "db:media-management": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/migrations/010_media_management.sql'",
    "db:grant-api-permissionsns": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f scripts/grant-api-permissions.sql'",
    "db:seed:initial-data": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/seeds/001_initial_data.sql'",
    "db:seed:crm-data": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/seeds/002_crm_data.sql'",
    "db:seed:manage-roles-permission": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/seeds/003_add_manage_roles_permission.sql'",
    "db:seed:custom-rbac-permissions": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f database/seeds/006_custom_rbac_permissions.sql'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint-config-next": "16.1.5",
    "lucide-react": "^0.577.0",
    "next": "16.1.5",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
